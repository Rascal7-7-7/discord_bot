# 必要な環境変数の一覧。値はすべてプレースホルダで、実値は入れない。
#
# 必須 = apps/*/src/config/env.ts の requireEnv() が読む。未設定だと起動時に落ちる。
# 任意 = process.env を直接参照。未設定なら既定値または機能が無効になる。

# ── kura（Discord ナレッジボット）: 必須
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DISCORD_TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-client-id
GUILD_ID=your-discord-guild-id

# ── kura / pulse 共通: 必須
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# ── kura: 任意（未設定だと週次ダイジェストが無効）
DIGEST_CHANNEL_ID=

# ── pulse（トレンドレポート）: 必須
PULSE_DISCORD_TOKEN=your-pulse-bot-token
PULSE_TREND_CHANNEL_ID=your-trend-channel-id
PULSE_LOG_CHANNEL_ID=your-log-channel-id
# 未認証だと GitHub Search API のレート制限に当たる
GITHUB_TOKEN=ghp_xxxxxxxx

# ── kura / pulse 共通: 任意（既定 8080）
PORT=8080
